# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email delivery service for "Send Sagar a message" form (choose either Resend or Formspree):
# 1. Resend (Recommended): Get your API key from https://resend.com/api-keys
RESEND_API_KEY="MY_RESEND_API_KEY"

# 2. Formspree (Alternative): Create a form at https://formspree.io and paste the form ID here
FORMSPREE_FORM_ID="MY_FORMSPREE_FORM_ID"
